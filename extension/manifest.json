{
  "manifest_version": 3,
  "name": "Kokiani",
  "version": "1.0.0",
  "description": "Local-first real-time browser tab audio capture and multilingual transcription.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kokiani"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}