{
  "manifest_version": 3,
  "name": "Transcripto",
  "version": "0.1.0",
  "description": "Capture browser-tab audio and transcribe it into text.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "action": {
    "default_title": "Transcripto",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}